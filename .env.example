# Local fixture demonstration. Secrets belong in private ignored files.
DATABASE_PASSWORD=codeduel_local
SPRING_PROFILES_ACTIVE=demo
JUDGE_MODE=FIXTURE
COOKIE_SECURE=false
PUBLIC_URL=http://localhost:5173

# Prefer worker/sandbox/setup-local.sh to generate real local execution settings.
# Remove the demo profile and set JUDGE_MODE=GO_JUDGE.
JUDGE_URL=
JUDGE_AUTH_TOKEN=

# Optional secured Judge0 adapter (Java 21 ID/name must come from your instance).
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
JUDGE0_JAVA_LANGUAGE_ID=0
JUDGE0_JAVA_LANGUAGE_NAME=Java (OpenJDK 21)

# Host development defaults. Docker routes SMTP to its local Mailpit service.
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_TLS=false
MAIL_FROM=noreply@codeduel.local

# Production uses deploy/compose.yml, configtree secret files and required TLS/SMTP.
# See docs/deployment-guide.md; do not promote these local defaults to production.
